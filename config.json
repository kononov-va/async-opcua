{
    "server_config":{
        "application_name": "OPC UA Vzljot Server",
        "application_uri": "urn:opcua-Vzljot-Server",
        "product_uri": "urn:OPC UA Vzljot Server Testkit",
        "create_sample_keypair": true,
        "certificate_path": "own/cert.der", 
        "private_key_path": "private/private.pem",
        "certificate_validation": {
            "trust_client_certs": true,
            "check_time": true
        },
        "pki_dir": "./pki",
        "discovery_server_url": "",
        "tcp_config": {
            "hello_timeout": 5,
            "host": "10.0.2.15",
            "port": 4855
        },
        "limits": {
            "clients_can_modify_address_space": false,
            "max_subscriptions": 100,
            "max_monitored_items_per_sub": 1000,
            "max_monitored_item_queue_size": 10,
            "max_array_length": 1000,
            "max_string_length": 65535,
            "max_byte_string_length": 65535,
            "min_sampling_interval": 0.1,
            "min_publishing_interval": 0.1
        },
        "locale_ids": [
            "en"
        ],
        "user_tokens": {
            "sample_password_user1": {
                "user": "sample1",
                "pass": "sample1pwd"
            },
            "sample_password_user2": {
                "user": "sample2",
                "pass": "sample2pwd"
            },
            "sample_x509_user": {
                "user": "sample_x509",
                "x509": "./users/sample-x509.der"
            },
            "unused_user": {
                "user": "unused",
                "pass": "unused1"
            }
        },
        "discovery_urls": [
            "opc.tcp://10.0.2.15:4855/"
        ],
        "default_endpoint": "none",
        "endpoints":{
            "aes128-sha256-rsaoaep_sign": {
                "path": "/",
                "security_policy": "Aes128-Sha256-RsaOaep",
                "security_mode": "Sign",
                "security_level": 2,
                "password_security_policy": "None",
                "user_token_ids": [
                    "ANONYMOUS",
                    "sample_password_user1",
                    "sample_password_user2",
                    "sample_x509_user"
                ]
            },
            "aes128-sha256-rsaoaep_sign_encrypt":{
                "path": "/",
                "security_policy": "Aes128-Sha256-RsaOaep",
                "security_mode": "SignAndEncrypt",
                "security_level": 12,
                "password_security_policy": "None",
                "user_token_ids":[
                    "ANONYMOUS",
                    "sample_password_user1",
                    "sample_password_user2",
                    "sample_x509_user"
                ]
            },
            "basic128rsa15_sign":{
                "path": "/",
                "security_policy": "Basic128Rsa15",
                "security_mode": "Sign",
                "security_level": 1,
                "password_security_policy": "None",
                "user_token_ids":[
                    "ANONYMOUS",
                    "sample_password_user1",
                    "sample_password_user2",
                    "sample_x509_user"
                ]
            },
            "basic128rsa15_sign_encrypt":{
                "path": "/",
                "security_policy": "Basic128Rsa15",
                "security_mode": "SignAndEncrypt",
                "security_level": 11,
                "password_security_policy": "None",
                "user_token_ids":[
                    "ANONYMOUS",
                    "sample_password_user1",
                    "sample_password_user2",
                    "sample_x509_user"
                ]
            },
            "basic256_sign":{
                "path": "/",
                "security_policy": "Basic256",
                "security_mode": "Sign",
                "security_level": 3,
                "password_security_policy": "None",
                "user_token_ids":[
                    "ANONYMOUS",
                    "sample_password_user1",
                    "sample_password_user2",
                    "sample_x509_user"
                ]
            },
            "basic256_sign_encrypt":{
                "path": "/",
                "security_policy": "Basic256",
                "security_mode": "SignAndEncrypt",
                "security_level": 13,
                "password_security_policy": "None",
                "user_token_ids":[
                    "ANONYMOUS",
                    "sample_password_user1",
                    "sample_password_user2",
                    "sample_x509_user"
                ]
            },
            "basic256sha256_sign": {
                "path": "/",
                "security_policy": "Basic256Sha256",
                "security_mode": "Sign",
                "security_level": 4,
                "password_security_policy": "None",
                "user_token_ids":[
                    "ANONYMOUS",
                    "sample_password_user1",
                    "sample_password_user2",
                    "sample_x509_user"
                ]
            },
            "basic256sha256_sign_encrypt":{
                "path": "/",
                "security_policy": "Basic256Sha256",
                "security_mode": "SignAndEncrypt",
                "security_level": 14,
                "password_security_policy": "None",
                "user_token_ids":[
                    "ANONYMOUS",
                    "sample_password_user1",
                    "sample_password_user2",
                    "sample_x509_user"
                ]
            },
            "none":{
                "path": "/",
                "security_policy": "None",
                "security_mode": "None",
                "security_level": 0,
                "password_security_policy": "None",
                "user_token_ids":[
                    "ANONYMOUS",
                    "sample_password_user1",
                    "sample_password_user2",
                    "sample_x509_user"
                ]
            }
        }
    },

    "devices":[
        {
            "device_ip_address": "10.11.204.41:502",
            "device_address": 2,
            "device_type": "URSV5xx",
            "device_name": "ЦВВ1",
            "connection_timeout": 100,
            "read_timeout": 100,
            "history_read_await": 100
        },
        {
            "device_ip_address": "10.11.204.41:502",
            "device_address": 3,
            "device_type": "URSV5xx",
            "device_name": "ЦВВ2",
            "connection_timeout": 100,
            "read_timeout": 100,
            "history_read_await": 100
        }
    ]
}